# Copy to `.env` and fill in. Never commit `.env`.

# Shared secret the glasses plugin must present before the bridge accepts commands.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
WINGMAN_TOKEN=

# Claude Console API key used by the Agent SDK (https://console.anthropic.com).
ANTHROPIC_API_KEY=

# Port the bridge listens on (the plugin's Vite dev server proxies /bridge here).
PORT=8787
