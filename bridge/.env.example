# Copy to `.env` and fill in. Never commit `.env`.

# Shared secret the glasses plugin must present before the bridge accepts commands.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
WINGMAN_TOKEN=

# Port the bridge listens on (the plugin's Vite dev server proxies /bridge here).
PORT=8787

# Name used to sign AI-drafted emails. Defaults to your Gmail display name.
USER_NAME=

# 1 = fixture calendar/inbox data; sends, drafts and invites are only logged.
FAKE_GOOGLE=0

# Gemini API key from https://aistudio.google.com/apikey. Empty = canned fake AI.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Deepgram API key from https://console.deepgram.com. Empty = scripted fake
# speech-to-text (also forced with FAKE_STT=1; FAKE_STT_TEXT overrides the script).
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# How often to re-check calendar and inbox.
POLL_SECONDS=180
