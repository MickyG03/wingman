# Copy this file to `.env.local` and fill it in. Never commit `.env.local`.

# Must match WINGMAN_TOKEN in bridge/.env. Dev-only: values here are baked into
# the bundle, so a pairing flow will replace this before packaging an .ehpk.
VITE_BRIDGE_TOKEN=

# Leave empty in dev (the Vite server proxies /bridge to localhost:8787).
# For a packaged build, set the tunnel URL, e.g. wss://wingman.example.com/ws
VITE_BRIDGE_URL=
